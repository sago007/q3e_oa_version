--- a/code/unix/unix_main.c
+++ b/code/unix/unix_main.c
@@ -810,9 +810,9 @@ void Sys_PrintBinVersion( const char* name )
 
 	fprintf( stdout, "\n\n%s\n", sep );
 #ifdef DEDICATED
-	fprintf( stdout, "Linux Quake3 Dedicated Server [%s %s]\n", date, time );
